# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit credentials.

# Anthropic API key for Kern Bot
VITE_ANTHROPIC_API_KEY=your_api_key_here

# Login credentials as a JSON array (minified, no line breaks).
# Each user: id, name, role, initials, color, email, password
# id must match a USERS_LIST entry in src/core/utils.jsx
VITE_SHELL_USERS=[{"id":"loren","name":"Loren C.","role":"Senior PM","initials":"LC","color":"#a78bfa","email":"loren@kernsteel.com","password":"changeme"}]

# ── Server-only — never prefix these with VITE_, they must never reach the ──
# browser bundle. Used by server/projectsightSync.js (api/sync-projectsight.js
# and, locally, `npm run dev`'s API middleware) to pull RFI/Issue/Project data
# from ProjectSight into Postgres on a schedule instead of the browser hitting
# ProjectSight directly on every page load.

# Same Trimble credentials as the VITE_PROJECTSIGHT_* ones above, just without
# the VITE_ prefix so they stay server-side.
PROJECTSIGHT_CONSUMER_KEY=your_consumer_key_here
PROJECTSIGHT_CONSUMER_SECRET=your_consumer_secret_here
PROJECTSIGHT_USAGE_PLAN_KEY=your_usage_plan_key_here

# Shared secret the GitHub Actions cron sends as `x-cron-secret` to authorize
# triggering a sync without a logged-in session. Generate any long random
# string; must match exactly what's set as a GitHub Actions secret
# (SYNC_CRON_SECRET) in .github/workflows/sync-projectsight.yml.
SYNC_CRON_SECRET=generate_a_long_random_string_here
