# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit credentials.

# Anthropic API key for Kern Bot
VITE_ANTHROPIC_API_KEY=your_api_key_here

# Login credentials as a JSON array (minified, no line breaks).
# Each user: id, name, role, initials, color, email, password
# id must match a USERS_LIST entry in src/core/utils.jsx
VITE_SHELL_USERS=[{"id":"loren","name":"Loren C.","role":"Senior PM","initials":"LC","color":"#a78bfa","email":"loren@kernsteel.com","password":"changeme"}]
